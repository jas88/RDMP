<Project>
	<PropertyGroup>
		<!-- TargetFramework is set in subdirectory Directory.Build.props files -->
		<!-- Generated by scripts/generate-build-props.sh based on SDK version -->
		<LangVersion>latest</LangVersion>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<!-- Enable cross-platform Windows targeting for WinForms projects -->
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<NoWarn>NU1902;NU1903;NU1904;1701;1702;CS1591;NU1701;CA1416;NUnit1032;NUnit1034</NoWarn>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<!-- Coverlet for test projects -->
	<ItemGroup Condition="'$(IsTestProject)' == 'true'">
		<PackageReference Include="coverlet.collector" PrivateAssets="All" />
	</ItemGroup>

	<!-- Compile time type registry: every project lists its own Types so that MEF finds them without reflection
	     (see Rdmp.Core.Repositories.CompiledTypeRegistry).  PrivateAssets keeps the generator out of NuGet package dependencies. -->
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Rdmp.Core.Generators'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)Rdmp.Core.Generators\Rdmp.Core.Generators.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<!-- Tests fail, rather than MEF falling back on reflection, if the compiled type registry cannot be used -->
	<ItemGroup Condition="'$(IsTestProject)' == 'true'">
		<RuntimeHostConfigurationOption Include="Rdmp.Core.Repositories.MEF.RequireCompiledTypeRegistry" Value="true" />
	</ItemGroup>
</Project>

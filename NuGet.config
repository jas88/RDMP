<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Preview packages with HangDump Linux fix (PR #6968) -->
    <add key="test-tools-preview" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/test-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Default: all packages from nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- Only Microsoft.Testing.* preview packages from test-tools feed -->
    <packageSource key="test-tools-preview">
      <package pattern="Microsoft.Testing.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

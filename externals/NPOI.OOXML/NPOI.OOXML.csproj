<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds NPOI.OOXML from the externals/npoi submodule sources.
       Mirrors externals/npoi/ooxml/NPOI.OOXML.Core.csproj (net10.0 target only). -->

  <PropertyGroup>
    <RootNamespace>NPOI</RootNamespace>
    <Version>2.8.0</Version>
    <IsPackable>false</IsPackable>
    <NpoiSrc>$(MSBuildThisFileDirectory)..\npoi\</NpoiSrc>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(NpoiSrc)npoi.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AnalysisLevel>none</AnalysisLevel>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0414;CS0419;CS0612;CS0618;CS0628;CS0649;CS0659;CS1570;CS1572;CS1573;CS1574;CS1584;CS1587;CS1591;CS1734;SYSLIB0021;SYSLIB0051;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile excludes mirror the upstream NPOI.OOXML.Core.csproj Remove list -->
    <Compile Include="$(NpoiSrc)ooxml\**\*.cs"
             Exclude="$(NpoiSrc)ooxml\obj\**;$(NpoiSrc)ooxml\bin\**;$(NpoiSrc)ooxml\POIFS\Crypt\Dsig\KeyInfoKeySelector.cs;$(NpoiSrc)ooxml\POIFS\Crypt\Dsig\Services\RelationshipTransformService.cs;$(NpoiSrc)ooxml\Properties\AssemblyInfoDotnet2.cs;$(NpoiSrc)ooxml\XSSF\UserModel\Charts\XSSFAreaChartData.cs;$(NpoiSrc)ooxml\XSSF\UserModel\Charts\XSSFColumnChartData.cs;$(NpoiSrc)ooxml\XSSF\UserModel\Charts\XSSFNumberCache.cs" />
    <Compile Include="$(NpoiSrc)main\Polyfills.cs" Link="Polyfills.cs" />
    <EmbeddedResource Include="$(NpoiSrc)ooxml\Resources\presetTableStyles.xml" LogicalName="NPOI.Resources.presetTableStyles.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPOI.Core\NPOI.Core.csproj" />
    <ProjectReference Include="..\NPOI.OpenXml4Net\NPOI.OpenXml4Net.csproj" />
    <ProjectReference Include="..\NPOI.OpenXmlFormats\NPOI.OpenXmlFormats.csproj" />
  </ItemGroup>

</Project>

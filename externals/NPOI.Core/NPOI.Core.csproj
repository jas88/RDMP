<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds NPOI (Apache-2.0) from source out of the externals/npoi git submodule.
    The official NPOI NuGet binary requires OSMF EULA acceptance; the source does not.
    This wrapper compiles the submodule sources under RDMP's own build settings and
    Central Package Management, so the submodule's build files are never used.
    Mirrors externals/npoi/main/NPOI.Core.csproj (net10.0 target only).
  -->

  <PropertyGroup>
    <RootNamespace>NPOI</RootNamespace>
    <Version>2.8.0</Version>
    <IsPackable>false</IsPackable>
    <NpoiSrc>$(MSBuildThisFileDirectory)..\npoi\</NpoiSrc>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(NpoiSrc)npoi.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AnalysisLevel>none</AnalysisLevel>
    <!-- Suppressions copied from NPOI's own Directory.Build.props (vendored code) -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0414;CS0419;CS0612;CS0618;CS0628;CS0649;CS0659;CS1570;CS1572;CS1573;CS1574;CS1584;CS1587;CS1591;CS1734;SYSLIB0021;SYSLIB0051;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(NpoiSrc)main\**\*.cs" Exclude="$(NpoiSrc)main\obj\**;$(NpoiSrc)main\bin\**" />
    <EmbeddedResource Include="$(NpoiSrc)main\Resources\font_metrics.properties" LogicalName="NPOI.Resources.font_metrics.properties" />
    <EmbeddedResource Include="$(NpoiSrc)main\Resources\functionMetadata.txt" LogicalName="NPOI.Resources.functionMetadata.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Enums.NET" />
    <PackageReference Include="ExtendedNumerics.BigDecimal" />
    <PackageReference Include="MathNet.Numerics.Signed" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="SharpZipLib" />
    <!-- ExcludeAssets=runtime mirrors the official NPOI package's dependency semantics -->
    <PackageReference Include="SkiaSharp" ExcludeAssets="runtime" />
    <PackageReference Include="ZString" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds NPOI.OpenXmlFormats from the externals/npoi submodule sources.
       Mirrors externals/npoi/OpenXmlFormats/NPOI.OpenXmlFormats.Core.csproj. -->

  <PropertyGroup>
    <Version>2.8.0</Version>
    <IsPackable>false</IsPackable>
    <NpoiSrc>$(MSBuildThisFileDirectory)..\npoi\</NpoiSrc>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(NpoiSrc)npoi.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AnalysisLevel>none</AnalysisLevel>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0414;CS0419;CS0612;CS0618;CS0628;CS0649;CS0659;CS1570;CS1572;CS1573;CS1574;CS1584;CS1587;CS1591;CS1734;SYSLIB0021;SYSLIB0051;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(NpoiSrc)OpenXmlFormats\**\*.cs" Exclude="$(NpoiSrc)OpenXmlFormats\obj\**;$(NpoiSrc)OpenXmlFormats\bin\**" />
    <Compile Include="$(NpoiSrc)main\Polyfills.cs" Link="Polyfills.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZString" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPOI.Core\NPOI.Core.csproj" />
    <ProjectReference Include="..\NPOI.OpenXml4Net\NPOI.OpenXml4Net.csproj" />
  </ItemGroup>

</Project>
